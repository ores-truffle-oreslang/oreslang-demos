pub routine main() => void {
  stdio.stdout.write("<!doctype html><html><head><meta charset=utf-8><title>Oreslang Web Demo</title></head><body><h1>Oreslang Web Demo</h1><p>This HTTP response body was generated by Oreslang.</p><p>The Java host only supplies the HTTP listener boundary.</p></body></html>");
  return;
}
